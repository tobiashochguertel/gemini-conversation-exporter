{
  "name": "gemini-conversation-exporter",
  "version": "0.6.0",
  "private": true,
  "description": "Reliable single-conversation Markdown exporter for Gemini Web",
  "author": "tobiashochguertel",
  "contributors": [
    "dikelps <dikelps@users.noreply.github.com> (original author)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/tobiashochguertel/gemini-conversation-exporter",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobiashochguertel/gemini-conversation-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/tobiashochguertel/gemini-conversation-exporter/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test",
    "check": "npm test && npm run build",
    "release": "node scripts/release.js",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "userscript": {
    "name": "Gemini Conversation Exporter",
    "namespace": "local.gemini-web-exporter",
    "description": "Export the current Gemini conversation as validated Markdown using Gemini's own paginated history data.",
    "match": [
      "https://gemini.google.com/*",
      "https://gemini.google.com/app",
      "https://gemini.google.com/app/*",
      "https://gemini.google.com/u/*/app",
      "https://gemini.google.com/u/*/app/*"
    ],
    "grant": [
      "unsafeWindow",
      "GM_getValue",
      "GM_setValue"
    ],
    "run-at": "document-idle",
    "sandbox": "JavaScript",
    "noframes": true
  },
  "devDependencies": {
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
